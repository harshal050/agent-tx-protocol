# Repository the site reads docs, benchmarks and stats from.
AGENTTX_GITHUB_REPO=harshal050/agent-tx-protocol
AGENTTX_GITHUB_BRANCH=main

# auto   = GitHub in production (local files as fallback), local files in development
# github = GitHub only; local = the monorepo checkout only
AGENTTX_CONTENT_SOURCE=auto

# Optional: raises the GitHub API rate limit and enables per-page "last updated".
GITHUB_TOKEN=

# Secret configured on the GitHub push webhook (POST /api/revalidate).
GITHUB_WEBHOOK_SECRET=

# Canonical URL (defaults to https://agenttx.site).
NEXT_PUBLIC_SITE_URL=https://agenttx.site
